diff --git a/cuda_buffer_backend/cuda_buffer/include/cuda_buffer/trace_log.hpp b/cuda_buffer_backend/cuda_buffer/include/cuda_buffer/trace_log.hpp
new file mode 100644
index 0000000..d68714a
--- /dev/null
+++ b/cuda_buffer_backend/cuda_buffer/include/cuda_buffer/trace_log.hpp
@@ -0,0 +1,45 @@
+// TEMPORARY instrumentation for diagnosing wrong-frame reads. Not for commit.
+#ifndef CUDA_BUFFER__TRACE_LOG_HPP_
+#define CUDA_BUFFER__TRACE_LOG_HPP_
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <chrono>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+namespace cuda_buffer_trace
+{
+inline int fd()
+{
+  static const int f = []() {
+      const char * p = std::getenv("CUDA_BUFFER_TRACE");
+      return p ? ::open(p, O_WRONLY | O_CREAT | O_APPEND, 0644) : -1;
+    }();
+  return f;
+}
+
+inline uint64_t now_us()
+{
+  return static_cast<uint64_t>(
+    std::chrono::duration_cast<std::chrono::microseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+inline void log(const char * fmt, ...)
+{
+  const int f = fd();
+  if (f < 0) {return;}
+  char buf[256];
+  va_list ap;
+  va_start(ap, fmt);
+  const int n = std::vsnprintf(buf, sizeof(buf), fmt, ap);
+  va_end(ap);
+  if (n > 0) {(void)!::write(f, buf, static_cast<size_t>(n));}
+}
+}  // namespace cuda_buffer_trace
+
+#endif  // CUDA_BUFFER__TRACE_LOG_HPP_
